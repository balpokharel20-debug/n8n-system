# Optional in local development; leave blank to use the ignored local JSON store.
# Use an auth-enabled local MongoDB instance; for deployed use, use MongoDB Atlas.
MONGODB_URI=
MONGODB_DB=relay

# Set true only after scripts/migrate-web-aayo.mjs --apply has backed up
# existing web_aayo_* records and created the indexes.
WEB_AAYO_SCHEMA_READY=false
# Long random token used by the optional n8n-to-Relay import workflow.
WEB_AAYO_AUTOMATION_TOKEN=
DEFAULT_TIMEZONE=Asia/Kathmandu

# AI integration is not called until a provider adapter is explicitly configured.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Run `npm run auth:setup` and copy the generated values into .env.local.
RELAY_ADMIN_PASSWORD_HASH=
RELAY_SESSION_SECRET=

# Required shared secret for incoming webhooks (x-relay-secret header).
RELAY_WEBHOOK_SECRET=

# Required bearer secret for the local cron runner and Vercel Cron.
CRON_SECRET=

# Workflow HTTP nodes can reference any server variable with {{env.NAME}}.
EXAMPLE_API_KEY=

# Meta Lead Ads and WhatsApp Cloud API.
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WELCOME_TEMPLATE=lead_welcome
WHATSAPP_REMINDER_TEMPLATE_DAY_1=lead_followup_day_1
WHATSAPP_REMINDER_TEMPLATE_DAY_3=lead_followup_day_3

# Google Sheets service account. Share the target sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Telegram admissions alerts and daily call list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMS fallback when WhatsApp is not configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Daily uncalled-lead digest settings.
BUSINESS_TIMEZONE=Asia/Kathmandu
DAILY_DIGEST_HOUR=9

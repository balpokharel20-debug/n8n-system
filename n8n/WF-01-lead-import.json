      "name": "Authenticated prospect import"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first()?.json ?? {};\nconst payload = input.body ?? input;\nconst rows = Array.isArray(payload) ? payload : payload.rows;\nif (!Array.isArray(rows) || rows.length === 0) throw new Error('Send a non-empty rows array.');\nif (rows.length > 1000) throw new Error('Import is limited to 1,000 rows.');\nif (rows.some((row) => !row || typeof row !== 'object' || Array.isArray(row))) throw new Error('Every row must be an object.');\nconst permitted = (value) => value === true || /^(1|true|yes|y|approved)$/i.test(String(value ?? ''));\nif (rows.some((row) => !permitted(row.source_usage_permitted))) throw new Error('Each row must explicitly confirm source_usage_permitted=true.');\nreturn [{ json: { rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "id": "901ad960-2ebc-42e9-bba0-4bc9f525965f",
      "name": "Validate bounded import"
    },
